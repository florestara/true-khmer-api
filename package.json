{
  "name": "truekhmer-api",
  "version": "1.0.0",
  "description": "TrueKhmer API - Hono.js with Drizzle ORM and PostgreSQL",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.mjs --packages=external",
    "start": "node dist/index.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seeds/index.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@hono/zod-openapi": "^1.2.3",
    "@scalar/hono-api-reference": "^0.10.4",
    "better-auth": "^1.4.18",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.45.1",
    "he": "^1.2.0",
    "hono": "^4.6.0",
    "postgres": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/he": "^1.2.3",
    "@types/node": "^22.19.11",
    "drizzle-kit": "^0.31.9",
    "esbuild": "^0.27.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
